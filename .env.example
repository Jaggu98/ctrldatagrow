# ====================================================================
# Ctrl + Data + Grow (CDG) - Environment Configuration Template
# ====================================================================

# 1. Frontend Supabase Configuration (Vite exposed client keys)
# Find these in your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# 2. Optional: Dedicated Backend Server Configuration
PORT=5000

# 3. Privileged Supabase Server Credentials (FOR SERVER-SIDE USE ONLY)
# NEVER prefix with VITE_ and NEVER commit real keys to Git.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
